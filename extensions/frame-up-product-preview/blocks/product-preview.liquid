{% if request.page_type == 'product' and product != blank and product.featured_image != blank %}
  {% assign preview_assets = block.settings.proxy_path | default: '/apps/frame-up' | append: '/assets/' %}
  <style>
    .frame-up-loading { position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; gap: 14px; padding: 24px; background: #ffffffd9; color: #454545; font: inherit; font-size: 14px; text-align: center; pointer-events: auto; cursor: progress; }
    .frame-up-loading::before { content: ''; width: 26px; height: 26px; border: 2px solid #d6d6d6; border-top-color: #454545; border-radius: 50%; animation: frame-up-loading-spin 800ms linear infinite; }
    @keyframes frame-up-loading-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .frame-up-loading::before { animation: none; } }
  </style>
  <frame-up-preview
    hidden
    data-proxy-path="{{ block.settings.proxy_path | escape }}"
    data-media-selector="{{ block.settings.media_selector | escape }}"
    data-room-width="65"
    data-room-scene="image"
    data-room-scale="2"
    data-room-center-x="{{ block.settings.room_center_x | default: 47 }}"
    data-room-center-y="{{ block.settings.room_center_y | default: 38 }}"
    data-runtime-url="{{ preview_assets | append: 'preview-runtime.js?v=56' | escape }}"
    data-webgl-url="{{ preview_assets | append: 'preview-webgl.js?v=54' | escape }}"
    data-tilt-y="15"
    data-min-zoom="1"
    data-max-zoom="3"
    data-zoom-speed="0.002"
    data-movement="1"
    data-damping="10"
    data-environment-url="{{ preview_assets | append: 'lebombo_1k.hdr' | escape }}"
    data-surface-texture-url="{{ preview_assets | append: 'concrete-light.jpg' | escape }}"
  >
    <script type="application/json" data-frame-up-product>
      {
        "id": {{ product.id | append: '' | json }},
        "type": {{ product.type | json | replace: '<', '\u003c' }},
        "handle": {{ product.handle | json }},
        "title": {{ product.title | json | replace: '<', '\u003c' }},
        "image": {{ product.featured_image | image_url: width: 5760 | json }},
        "previewImage": {{ product.featured_image | image_url: width: 1600 | json }},
        "imageWidth": {{ product.featured_image.width | json }},
        "imageHeight": {{ product.featured_image.height | json }},
        "optionNames": {{ product.options | json | replace: '<', '\u003c' }},
        "selectedVariant": {{ product.selected_or_first_available_variant | json | replace: '<', '\u003c' }}
      }
    </script>
    <div class="frame-up-stage" data-mode="spatial" role="region" tabindex="0" aria-label="Artwork preview. Hover to view depth. Click or press Enter to zoom in or out.">
      {% if block.settings.room_image != blank %}
        {{ block.settings.room_image | image_url: width: 1800 | image_tag: class: 'frame-up-room', alt: 'Room setting', loading: 'lazy' }}
      {% else %}
        <img class="frame-up-room" src="{{ preview_assets | append: 'room-console.jpg' | escape }}" alt="Room setting" width="1254" height="1254" loading="lazy">
      {% endif %}
      <div class="frame-up-object" aria-label="Framed artwork">
        <div class="frame-up-back"></div>
        <div class="frame-up-edge frame-up-edge-left"></div>
        <div class="frame-up-edge frame-up-edge-right"></div>
        <div class="frame-up-edge frame-up-edge-top"></div>
        <div class="frame-up-edge frame-up-edge-bottom"></div>
        <div class="frame-up-face">
          <div class="frame-up-mat">
            <img class="frame-up-art" alt="{{ product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" draggable="false">
            <div class="frame-up-tint"></div>
          </div>
          <div class="frame-up-glass"></div>
        </div>
      </div>
      <button class="frame-up-view-toggle" type="button" aria-pressed="false">View in a room</button>
      <span class="frame-up-sr-only" aria-live="polite" data-frame-up-description></span>
    </div>
  </frame-up-preview>
  <script>
    (async (host) => {
      if (!host || host.dataset.loading) return;
      host.dataset.loading = 'true';
      let previewStarted = false;
      let loader, gallery, loaderTarget, loadingTimer, originalPosition, originalDisplay, originalBusy;
      host.finishLoading = () => {
        clearTimeout(loadingTimer);
        loader?.remove();
        loader = null;
        if (gallery) {
          if (originalPosition !== undefined && loaderTarget) loaderTarget.style.position = originalPosition;
          if (originalDisplay !== undefined && loaderTarget) loaderTarget.style.display = originalDisplay;
          if (originalBusy === null) gallery.removeAttribute('aria-busy');
          else gallery.setAttribute('aria-busy', originalBusy);
          gallery = null;
          loaderTarget = null;
        }
      };
      host.findPreviewGallery = () => {
        const main = document.querySelector('main') || document;
        const selectors = host.dataset.mediaSelector ? [host.dataset.mediaSelector] : [
          '[data-product-media-wrapper]', '.product__media-wrapper', '.product-information__media', '[data-testid="product-information-media"]',
          '[data-product-media-gallery]', 'media-gallery', '[id^="MediaGallery-"]', '.product-gallery', '.product-media',
        ];
        for (const selector of selectors) {
          try {
            const element = main.querySelector(selector);
            if (element && !host.contains(element)) return element.closest('[data-product-media-wrapper]') || element;
          } catch { return null; }
        }
        return null;
      };
      try {
        const proxy = (host.dataset.proxyPath || '/apps/frame-up').replace(/\/$/, '');
        if (!/^\/(apps|a|community|tools)\/[\w-]+$/.test(proxy)) return;
        const product = JSON.parse(host.querySelector('[data-frame-up-product]').textContent);
        if (!product.type || !product.image) return;
        gallery = host.findPreviewGallery();
        if (gallery) {
          originalBusy = gallery.getAttribute('aria-busy');
          gallery.setAttribute('aria-busy', 'true');
          const mediaSelectors = [
            '[data-media-main]',
            '.product__media-item.is-active .product__media', '.product__media-item.is-active',
            '.product-media-container', '.product__media-item .product__media',
            '.product__media-item', '.product__media', '[data-media-id]', '.product-media',
          ];
          for (const selector of mediaSelectors) {
            loaderTarget = [...gallery.querySelectorAll(selector)].find((element) => {
              const rect = element.getBoundingClientRect();
              return rect.width > 0 && rect.height > 0;
            });
            if (loaderTarget) break;
          }
          loaderTarget ||= gallery;
          if (getComputedStyle(loaderTarget).display === 'inline') {
            originalDisplay = loaderTarget.style.display;
            loaderTarget.style.display = 'block';
          }
          if (getComputedStyle(loaderTarget).position === 'static') {
            originalPosition = loaderTarget.style.position;
            loaderTarget.style.position = 'relative';
          }
          loader = document.createElement('div');
          loader.className = 'frame-up-loading';
          loader.setAttribute('role', 'status');
          loader.setAttribute('aria-live', 'polite');
          loader.textContent = 'Loading product configuration…';
          for (const eventName of ['click', 'dblclick', 'pointerdown', 'pointerup', 'touchend']) {
            loader.addEventListener(eventName, (event) => {
              event.preventDefault();
              event.stopPropagation();
            }, { passive: false });
          }
          loaderTarget.append(loader);
          loadingTimer = setTimeout(host.finishLoading, 20000);
        }
        const query = new URLSearchParams({ product_id: product.id, product_type: product.type });
        const response = await fetch(`${proxy}/preview?${query}`, { headers: { Accept: 'application/json' } });
        if (!response.ok) return;
        const result = await response.json();
        if (!result.enabled) return;
        const config = document.createElement('script');
        config.type = 'application/json';
        config.dataset.frameUpConfig = '';
        config.textContent = JSON.stringify(result);
        host.append(config);
        const stylesheet = document.createElement('link');
        stylesheet.rel = 'stylesheet';
        stylesheet.href = `${proxy}/assets/product-preview.css?v=53`;
        const stylesReady = new Promise((resolve, reject) => {
          stylesheet.onload = resolve;
          stylesheet.onerror = reject;
          document.head.append(stylesheet);
        });
        const [{ default: Preview }, { default: SpatialPreview }] = await Promise.all([
          import(host.dataset.runtimeUrl), import(host.dataset.webglUrl), stylesReady,
        ]);
        host.SpatialPreview = SpatialPreview;
        previewStarted = true;
        if (!customElements.get('frame-up-preview')) customElements.define('frame-up-preview', Preview);
      } catch (error) {
        previewStarted = false;
        console.warn('Frame Up preview assets could not be loaded.', error);
      } finally {
        if (!previewStarted) host.finishLoading();
      }
    })(document.currentScript.previousElementSibling);
  </script>
{% endif %}

{% comment %}
  Archived settings. Keep outside schema because Shopify requires valid JSON.
    { "type": "range", "id": "tilt_y", "label": "Horizontal tilt limit", "min": 0, "max": 25, "step": 1, "default": 12, "unit": "°" },
    { "type": "range", "id": "min_zoom", "label": "Minimum zoom", "min": 50, "max": 100, "step": 5, "default": 100, "unit": "%" },
    { "type": "range", "id": "max_zoom", "label": "Maximum zoom", "min": 100, "max": 600, "step": 25, "default": 300, "unit": "%" },
    { "type": "range", "id": "zoom_speed", "label": "Wheel zoom speed", "min": 1, "max": 50, "step": 1, "default": 20 },
    { "type": "range", "id": "movement_strength", "label": "Magnifier movement", "min": 0, "max": 100, "step": 5, "default": 100, "unit": "%" },
    { "type": "range", "id": "damping", "label": "Interaction responsiveness", "min": 1, "max": 30, "step": 1, "default": 10 },
    { "type": "paragraph", "content": "Shows a spatial artwork preview only on products successfully linked to a Frame Up configuration. Your theme controls sizes, variants and checkout." },
    { "type": "range", "id": "procedural_room_width", "label": "Default room wall width", "unit": "in", "min": 60, "max": 240, "step": 5, "default": 65 },
    { "type": "range", "id": "room_scale", "label": "Artwork scale in room", "unit": "%", "min": 75, "max": 200, "step": 5, "default": 200 },
    { "type": "range", "id": "room_width", "label": "Room scene width", "unit": "in", "min": 60, "max": 240, "step": 5, "default": 65 },
{% endcomment %}

{% schema %}
{
  "name": "Frame Up product preview",
  "target": "body",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "image_picker", "id": "room_image", "label": "Room background" },
    { "type": "range", "id": "room_center_x", "label": "Artwork horizontal position", "unit": "%", "min": 10, "max": 90, "step": 1, "default": 47 },
    { "type": "range", "id": "room_center_y", "label": "Artwork vertical position", "unit": "%", "min": 10, "max": 70, "step": 1, "default": 38 },
    { "type": "text", "id": "proxy_path", "label": "App proxy URL path", "default": "/apps/frame-up", "info": "If you customize the App Proxy URL in Shopify admin, enter the same path here (for example, /tools/art-preview) and save." },
    { "type": "text", "id": "media_selector", "label": "Product media CSS selector", "info": "Optional for custom themes. Leave empty to detect the product gallery automatically." }
  ]
}
{% endschema %}
